<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel Administrativo - Notificaciones</title>
    <!-- Usando Bootstrap para que la interfaz se vea profesional de inmediato -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 600px;">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Panel Administrativo: Enviar Notificación</h4>
            </div>
            <div class="card-body">
                
                <!-- Mostrar mensaje de éxito si la notificación se envió -->
                {% if messages %}
                    {% for message in messages %}
                        <div class="alert alert-success">{{ message }}</div>
                    {% endfor %}
                {% endif %}

                <!-- Formulario de la página administrativa -->
                <form method="POST" action="">
                    {% csrf_token %}
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">ID del Usuario (Destinatario):</label>
                        <input type="text" name="usuario_id" class="form-control" required placeholder="Ej. user_123">
                        <div class="form-text">El identificador del usuario que recibirá la alerta en la APK.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Título:</label>
                        <input type="text" name="titulo" class="form-control" required placeholder="Ej. Actualización de ruta">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mensaje de la notificación:</label>
                        <textarea name="mensaje" class="form-control" rows="3" required placeholder="Escribe los detalles aquí..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Registrar y Enviar a Firebase</button>
                </form>

            </div>
        </div>
    </div>
</body>
</html>